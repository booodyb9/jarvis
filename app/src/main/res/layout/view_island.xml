<?xml version="1.0" encoding="utf-8"?>
<!-- The task island. IslandFrame draws the black shape and morphs it between the compact pill
     (@id/compact) and the expanded card (@id/expanded). -->
<com.jarvis.assistant.ui.IslandFrame xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/island"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/compact"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:gravity="center_vertical"
        android:minWidth="128dp"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingEnd="13dp">

        <com.jarvis.assistant.ui.ArcReactorView
            android:id="@+id/islandOrb"
            android:layout_width="20dp"
            android:layout_height="20dp" />

        <ImageView
            android:id="@+id/islandResult"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/islandText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:ellipsize="end"
            android:maxWidth="210dp"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:text="Opening WhatsApp…" />

        <com.jarvis.assistant.ui.LevelBars
            android:id="@+id/islandBars"
            android:layout_width="20dp"
            android:layout_height="16dp"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/expanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/expHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.jarvis.assistant.ui.ArcReactorView
                android:id="@+id/expOrb"
                android:layout_width="26dp"
                android:layout_height="26dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Jarvis"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/expState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8E8E93"
                android:textSize="13sp"
                tools:text="Working" />

            <com.jarvis.assistant.ui.LevelBars
                android:id="@+id/expBars"
                android:layout_width="20dp"
                android:layout_height="16dp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/expTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            tools:text="Send my wife a message on WhatsApp and tell her I love her" />

        <TextView
            android:id="@+id/expStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="#A1A1A6"
            android:textSize="14sp"
            tools:text="Opening WhatsApp…" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/expPrimary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_island_button"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                tools:text="Stop" />

            <TextView
                android:id="@+id/expSecondary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_island_button"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                tools:text="Open Jarvis" />
        </LinearLayout>
    </LinearLayout>
</com.jarvis.assistant.ui.IslandFrame>
