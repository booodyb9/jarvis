<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Jarvis.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Models"
            tools:ignore="HardcodedText" />

        <TextView
            style="@style/Jarvis.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Jarvis uses your primary model (★). Tap a model to edit it or make it primary."
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical" />

        <!-- Empty state -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/empty"
            style="@style/Jarvis.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="14dp"
                    android:src="@drawable/ic_memory"
                    app:tint="@color/accent"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No models yet"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    style="@style/Jarvis.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Add Claude, OpenAI, or a model running on your own computer with LM Studio or Ollama."
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addButton"
            style="@style/Jarvis.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Add model"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            tools:ignore="HardcodedText" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Jarvis.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/fallbackSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use backup models"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    style="@style/Jarvis.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="If the primary model can't be reached (offline, out of credit, server down), Jarvis carries on with your other models, top to bottom."
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
